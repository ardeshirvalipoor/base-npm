{
  "name": "@codesuma/baseline",
  "version": "1.3.0",
  "description": "A minimal, imperative UI framework for building fast web apps. No virtual DOM, no magic, no dependencies.",
  "main": "index.ts",
  "types": "index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "components/**/*",
    "helpers/**/*",
    "lib/**/*",
    "utils/**/*",
    "index.ts",
    "README.md",
    "!**/*.test.ts"
  ],
  "keywords": [
    "ui",
    "framework",
    "spa",
    "router",
    "imperative",
    "minimal",
    "typescript"
  ],
  "author": "ardeshirvalipoor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ardeshirvalipoor/base-npm.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^4.9.5",
    "vitest": "^4.1.9"
  }
}
