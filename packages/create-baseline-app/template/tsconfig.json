{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "declaration": false,
        "sourceMap": true,
        "strict": true,
        "allowJs": true,
        "outDir": "./build",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "baseUrl": "."
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
