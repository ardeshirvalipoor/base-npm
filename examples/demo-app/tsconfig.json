{
    "compilerOptions": {
        "noImplicitAny": true,
        "target": "es5",
        "module": "es6",
        "moduleResolution": "node",
        "declaration": false,
        "downlevelIteration": true,
        "sourceMap": true,
        "strictNullChecks": true,
        "allowJs": true,
        "outDir": "./build",
        "types": [],
        "lib": [
            "dom",
            "dom.iterable",
            "es5",
            "es7",
            "es2015.promise",
            "es2017.object",
            "es2019"
        ],
        "baseUrl": ".",
        "paths": {
            "@codesuma/baseline": [
                "../../packages/baseline"
            ],
            "@codesuma/baseline/*": [
                "../../packages/baseline/*"
            ]
        }
    },
    "include": [
        "./**/*",
        "../../packages/baseline/**/*"
    ],
    "exclude": [
        "node_modules",
        "rollup.config.js",
        "../../packages/baseline/**/*.test.ts",
        "../../packages/baseline/vitest.config.ts"
    ]
}